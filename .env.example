# E-Courtier Global Environment Variables Example

# Database (PostgreSQL)
POSTGRES_DB=ecourtier_db
POSTGRES_USER=ecourtier_user
POSTGRES_PASSWORD=ecourtier_secure_pass_2026
POSTGRES_PORT=5432

# Backend Spring Boot
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# Intelligence Artificielle (RENDER-GEMINI-01)
# Google Gemini est le seul fournisseur LLM externe autorisé ; secours déterministe local (RuleBasedCriteriaExtractor).
IA_ENABLED=true
AI_PROVIDER=gemini
IA_PROVIDER=gemini
AI_FALLBACK_PROVIDER=local

# Fournisseur unique autorisé : Google Gemini (Google AI Studio / Generative Language API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=4000

# Paiement — PayTech Sandbox (env=test uniquement, Wave ciblé)
# Par défaut PAYMENT_PROVIDER=mock (simulation locale sans débit réel).
# Attention : PayTech env=test peut débiter 100 à 150 FCFA réels sur la page checkout.
# Sécurité zéro débit : ecourtier.payment.paytech.zero-debit-guaranteed reste fixé à false
# dans application.yml afin de bloquer tout appel réseau PayTech tant que le zéro débit n'est pas garanti.
PAYMENT_PROVIDER=mock
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_IPN_URL=
PAYTECH_SUCCESS_URL=
PAYTECH_CANCEL_URL=
PAYTECH_TARGET_PAYMENT=Wave

# Frontend React / Vite
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
