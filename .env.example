# E-Courtier Global Environment Variables Example

# Database (PostgreSQL)
POSTGRES_DB=ecourtier_db
POSTGRES_USER=ecourtier_user
POSTGRES_PASSWORD=ecourtier_secure_pass_2026
POSTGRES_PORT=5432

# Backend Spring Boot
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# Frontend React / Vite
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
