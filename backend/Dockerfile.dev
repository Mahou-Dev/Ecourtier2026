# Dev & Hot-Reload Spring Boot Environment
FROM maven:3.9.9-eclipse-temurin-21-alpine

WORKDIR /app

# Create non-root group and user & configure home
RUN addgroup -S appgroup && adduser -S appuser -G appgroup && \
    mkdir -p /home/appuser/.m2 /app/target && \
    chown -R appuser:appgroup /home/appuser /app

USER appuser

# Copy pom.xml and source code
COPY --chown=appuser:appgroup pom.xml .
COPY --chown=appuser:appgroup src ./src

EXPOSE 8080

# Start Spring Boot application with live reloading (DevTools enabled)
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.profiles=dev"]
